# Workplane Browser Gateway - P0 Firecrawl Configuration
# Copy this file to .env and fill in the required values
# NEVER commit .env with real secrets to version control

# ============================================
# CORE CONFIGURATION
# ============================================

# Firecrawl version pin - DO NOT change without explicit approval
FIRECRAWL_VERSION=v2.11.162

# API Configuration
API_PORT=3002
INTERNAL_PORT=3002
WORKER_PORT=3005

# Authentication - P0 uses simple bearer token
# For production, enable USE_DB_AUTHENTICATION and configure database auth
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=change-this-to-a-secure-random-key-min-32-chars

# Test API Key (optional, for SDK client testing)
# TEST_API_KEY=test-key-123

# ============================================
# DATABASE & QUEUE CONFIGURATION
# ============================================

POSTGRES_USER=postgres
# REQUIRED: Replace with at least 32 random characters
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_RANDOM_PASSWORD_32_CHARS
POSTGRES_DB=postgres

RABBITMQ_USER=firecrawl
# REQUIRED: Replace with secure password
RABBITMQ_PASSWORD=CHANGE_ME_TO_SECURE_RANDOM_PASSWORD_32_CHARS

# ============================================
# RESOURCE & LIMITS
# ============================================

# Worker concurrency limits
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3

# Timeout configuration
HARNESS_STARTUP_TIMEOUT_MS=60000

# ============================================
# LOGGING & OBSERVABILITY
# ============================================

LOGGING_LEVEL=info

# ============================================
# OPTIONAL: PROXY CONFIGURATION
# ============================================

# Uncomment and configure if you need proxy support
# PROXY_SERVER=http://your-proxy:port
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ============================================
# OPTIONAL: ALLOW LOCAL WEBHOOKS
# ============================================

# WARNING: Only enable in trusted development environments
ALLOW_LOCAL_WEBHOOKS=false

# ============================================
# OPTIONAL: BLOCK MEDIA
# ============================================

# Enable to reduce bandwidth by blocking media downloads
BLOCK_MEDIA=false

# ============================================
# SECURITY NOTES
# ============================================

# 1. NEVER use default or example passwords
# 2. Set USE_DB_AUTHENTICATION=true for production database-backed auth
# 3. Restrict network access to the API port via firewall or reverse proxy
# 4. Never expose this deployment without authentication to public networks
# 5. Rotate BULL_AUTH_KEY and passwords before each deployment
# 6. Store this file securely; it contains sensitive configuration
