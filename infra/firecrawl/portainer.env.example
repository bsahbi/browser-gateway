# Portainer stack variables for docker-compose.portainer.yml.
# Copy values into Portainer's Environment variables UI or secret manager.
# Do not commit a real .env file.

# Public DNS name handled by Traefik.
DOMAIN_NAME=browser.example.com

# Existing external Docker network shared with Traefik. Inspect it with
# `docker network ls` on the Portainer endpoint; common names are proxy or traefik.
TRAEFIK_NETWORK=proxy
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional: after the repository's release workflow publishes the fixed API
# wrapper, this can replace the upstream API image in the same stack.
# FIRECRAWL_API_IMAGE=ghcr.io/bsahbi/browser-gateway/firecrawl:latest

# The official MCP server image is currently linux/amd64 only. Leave this on
# standard amd64 Portainer hosts; ARM hosts require Docker's amd64 emulation.
MCP_PLATFORM=linux/amd64

# Generated values. Use separate 32-byte hex values for each secret.
BULL_AUTH_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Use `htpasswd -nbB <user> '<password>' | sed -e 's/\$/$$/g'` and paste the
# complete result. The doubled dollar signs keep Docker Compose from treating
# the bcrypt hash as environment-variable syntax.
TRAEFIK_BASIC_AUTH=operator:REPLACE_WITH_ESCAPED_BCRYPT_HASH

# Optional operational tuning.
# NUM_WORKERS_PER_QUEUE=4
# CRAWL_CONCURRENT_REQUESTS=5
# MAX_CONCURRENT_JOBS=3
# BROWSER_POOL_SIZE=3
