# Workplane Browser Gateway - P0 Firecrawl Configuration
# Generated from .env.example - UPDATE VALUES BEFORE DEPLOYMENT

# ============================================
# CORE CONFIGURATION
# ============================================

FIRECRAWL_VERSION=v2.11.162
API_PORT=3002
INTERNAL_PORT=3002
WORKER_PORT=3005

# Authentication (P0 uses simple bearer token)
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=wpg-p0-secret-auth-key-change-in-production-2024

# ============================================
# DATABASE & QUEUE CONFIGURATION
# ============================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=wpg-p0-postgres-secret-2024-change-me
POSTGRES_DB=postgres

RABBITMQ_USER=firecrawl
RABBITMQ_PASSWORD=wpg-p0-rabbitmq-secret-2024-change-me

# ============================================
# RESOURCE & LIMITS
# ============================================

NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3
HARNESS_STARTUP_TIMEOUT_MS=60000

# ============================================
# LOGGING
# ============================================

LOGGING_LEVEL=info

# ============================================
# OPTIONAL: PROXY & WEBHOOKS
# ============================================

ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=false
