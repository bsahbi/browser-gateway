# Alias image for the Firecrawl API only. It must be deployed with the Redis,
# RabbitMQ, NuQ PostgreSQL, Playwright, and MCP services in the Compose stack.
# It deliberately does not contain a Docker socket or try to launch a stack.
FROM ghcr.io/firecrawl/firecrawl:2.11.162@sha256:1b223ef18d410f67615f32ccaa3dcedfc26af4286f096247bddca3b624545e63

LABEL org.opencontainers.image.title="Workplane Firecrawl API"
LABEL org.opencontainers.image.description="Pinned Firecrawl API image for the Workplane Portainer stack"
LABEL org.opencontainers.image.source="https://github.com/bsahbi/browser-gateway"
LABEL org.opencontainers.image.version="2.11.162"

EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://localhost:3002/v0/health/readiness >/dev/null || exit 1

CMD ["node", "dist/src/harness.js", "--start-docker"]
