{
  "name": "browser-gateway",
  "version": "1.0.0",
  "description": "Workplane Browser Gateway - Browser acquisition and automation gateway",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/router",
    "packages/providers/*",
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace=@browser-gateway/api",
    "lint": "tsc --noEmit --project apps/api/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
