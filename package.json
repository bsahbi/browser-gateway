{
  "name": "browser-gateway",
  "version": "1.0.0",
  "description": "Workplane Browser Gateway - Browser acquisition and automation gateway",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/router",
    "packages/providers/*",
    "packages/control-plane",
    "packages/session-manager",
    "packages/capacity-manager",
    "apps/api",
    "apps/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@browser-gateway/api",
    "dev:mcp": "npm run dev --workspace=@browser-gateway/mcp",
    "lint": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
