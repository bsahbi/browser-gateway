{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@browser-gateway/contracts": ["packages/contracts/src/index.ts"],
      "@browser-gateway/router": ["packages/router/src/index.ts"],
      "@browser-gateway/provider-firecrawl": ["packages/providers/firecrawl/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist"]
}
