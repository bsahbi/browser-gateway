{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@browser-gateway/contracts": ["packages/contracts/src/index.ts"],
      "@browser-gateway/router": ["packages/router/src/index.ts"],
      "@browser-gateway/provider-firecrawl": ["packages/providers/firecrawl/src/index.ts"]
    }
  },
  "references": [
    {"path": "./packages/contracts"},
    {"path": "./packages/capacity-manager"},
    {"path": "./packages/session-manager"},
    {"path": "./packages/control-plane"},
    {"path": "./packages/router"},
    {"path": "./packages/distributed-system"},
    {"path": "./packages/providers/firecrawl"},
    {"path": "./packages/providers/playwright"},
    {"path": "./packages/providers/mobile"},
    {"path": "./apps/api"},
    {"path": "./apps/mcp"}
  ],
  "exclude": ["node_modules", "**/dist"]
}
